# Multi Apple Game — 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   .env 안의 값을 채운다.
#   `python applegame.py` 또는 uvicorn 실행 시 자동 로드됨.
#
# 절대 .env (실제 값 포함) 를 커밋하지 말 것. .gitignore 에 등록되어 있음.

# ---- Monitoring ----
# /monitoring 엔드포인트의 ?token=... 와 일치해야 통과.
# 비워두면 외부 IP는 403, 127.0.0.1 (서버 로컬) 만 허용.
# 운영 서버에 배포할 땐 충분히 긴 랜덤 토큰을 설정할 것.
#   예: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITORING_TOKEN=

# ---- Feedback / 문의 ----
# 문의 알림을 보낼 디스코드 웹훅 URL. 문의는 DB 없이 이 웹훅으로만 전달됨.
# 비워두면 문의 전송이 실패하고 사용자에게 '전송 실패'가 표시됨.
DISCORD_WEBHOOK_URL=
